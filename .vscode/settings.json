{
	// このリポジトリ内のファイルに対する設定
	// `.editorconfig` と同じ設定にしている
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"[markdown]": {
		"files.trimTrailingWhitespace": false
	},
	// Deno の拡張機能を利用している場合は、この設定を無効化する
	"deno.enable": false,
	// 大きなディレクトリは監視を無効化する
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/node_modules": true
	},
	// スペルチェックで無視すべき (正しいスペルとして認識すべき) 単語を列挙している
	"cSpell.words": [
		// ツールの名称
		"bento4", "gpac",
		// 仕様の名称
		"cenc", "pssh", "piff",
		// ソフトウェアやライブラリの名称
		"ffprobe",
		"libx264",
		"libx265",
		"libvpx",
		"libsvtav1",
		"opus", "vorbis",
		"libfreetype",
		// Homebrew 関連の名称
		"linuxbrew",
		"garnajee", "perso",
	],
}